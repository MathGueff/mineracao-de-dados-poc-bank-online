<mxfile host="drawio" version="26.0.0">
  <diagram id="fase5-ia-mcp" name="Fase 5 - Arquitetura de Integracao IA e Governanca MCP (ADR-005)">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="Tier1" value="1. Canais de Entrada, Gatilhos de Eventos &amp; Supervisão Humana Obrigatória (Human-in-the-Loop — KPI-04)" style="swimlane;startSize=30;fillColor=#fce4ec;strokeColor=#ad1457;fontColor=#880e4f;fontStyle=1;rounded=1;html=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1520" height="130" as="geometry" /></mxCell>
        <mxCell id="EvtKafka" value="⚡ Eventos de Negócio (Apache Kafka)&#10;Tópicos: ordem.executada | variacao.mercado.relevante" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="Tier1"><mxGeometry x="40" y="48" width="440" height="62" as="geometry" /></mxCell>
        <mxCell id="AppInvestidor" value="👤 Cliente Investidor (App Mobile / Web SPA)&#10;Solicita Recomendação / Visualiza Tese Aprovada" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="Tier1"><mxGeometry x="540" y="48" width="440" height="62" as="geometry" /></mxCell>
        <mxCell id="AssessorHitL" value="👨‍💼 Painel do Assessor Humano (Human-in-the-Loop)&#10;Revisa Citações RAG e Assina Evento RecomendacaoAprovada" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="Tier1"><mxGeometry x="1040" y="48" width="440" height="62" as="geometry" /></mxCell>

        <mxCell id="Tier2" value="2. Ecossistema de Inteligência Artificial &amp; Automação (Seção 4 da POC: n8n + Agentes Autônomos + LLMs + RAG)" style="swimlane;startSize=32;fillColor=#f3e5f5;strokeColor=#6a1b9a;fontColor=#4a148c;fontStyle=1;rounded=1;html=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="1520" height="270" as="geometry" /></mxCell>
        <mxCell id="OrqN8N" value="4. Orquestrador n8n (Low-Code Workflows)&#10;• Workflows versionados em Git (dev/hom/prod)&#10;• Segredos no HashiCorp Vault &amp; Anonimização DLP&#10;• Retry Exponencial (3x) + Dead-Letter Queue (DLQ)&#10;• Exportação de Métricas para Prometheus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="Tier2"><mxGeometry x="30" y="55" width="350" height="190" as="geometry" /></mxCell>
        <mxCell id="AgenteAutonomo" value="2. Agentes de IA Autônomos (Clientes MCP)&#10;• Loop: Planejamento → Ação → Observação&#10;• Memória de Curto Prazo (Sessão) e Longo Prazo&#10;• Bloqueio de Ações Irreversíveis (aprovacaoHumana=false)&#10;• Emissão Obrigatória de Eventos de Auditoria" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="Tier2"><mxGeometry x="410" y="55" width="360" height="190" as="geometry" /></mxCell>
        <mxCell id="MotorLLM" value="1. LLMs — Estrutura de Linguagem Natural&#10;• API Gerenciada com Política Zero Data Retention&#10;• Catálogo Versionado de Prompts de Sistema&#10;• Guardrails de Segurança, Suitability e Anti-Alucinação&#10;• Saída JSON Estruturada (Agregado Recomendacao)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="Tier2"><mxGeometry x="800" y="55" width="340" height="190" as="geometry" /></mxCell>
        <mxCell id="MotorRAG" value="3. Mecanismo RAG (Grounding &amp; Citações)&#10;• Ingestão: Extração → Limpeza → Chunking → Embeddings&#10;• Consulta: Similaridade → Re-ranking → Prompt Enriquecido&#10;• Reindexação Incremental via CDC&#10;• Citação Obrigatória de Lâminas/Normativos (KPI-04)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="Tier2"><mxGeometry x="1170" y="55" width="320" height="190" as="geometry" /></mxCell>

        <mxCell id="Tier3" value="3. Camada de Governança e Isolamento MCP — Model Context Protocol (ADR-005 | JSON-RPC 2.0 sobre mTLS em Kubernetes)" style="swimlane;startSize=32;fillColor=#e8f5e9;strokeColor=#2e7d32;fontColor=#1b5e20;fontStyle=1;rounded=1;html=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="1520" height="190" as="geometry" /></mxCell>
        <mxCell id="MCPRisk" value="🛡️ Servidor MCP-RiskCompliance&#10;Tool: validate_client_suitability&#10;Escopo: mcp:read:suitability&#10;Valida KYC, Limites e PLD/FT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="Tier3"><mxGeometry x="30" y="55" width="275" height="110" as="geometry" /></mxCell>
        <mxCell id="MCPCore" value="💼 Servidor MCP-CoreBancario&#10;Tool: get_portfolio_summary&#10;Escopo: mcp:read:portfolio_anon&#10;Lê Posições e Saldo Projetado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="Tier3"><mxGeometry x="330" y="55" width="275" height="110" as="geometry" /></mxCell>
        <mxCell id="MCPMarket" value="📈 Servidor MCP-MarketData&#10;Resource: market://quotes/{ticker}&#10;Escopo: mcp:read:marketdata&#10;Streaming de Cotações e Índices" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="Tier3"><mxGeometry x="630" y="55" width="275" height="110" as="geometry" /></mxCell>
        <mxCell id="MCPCRM" value="🤝 Servidor MCP-CRM&#10;Tool: register_advisor_task&#10;Escopo: mcp:write:crm_hitl&#10;Sincroniza Mesa &amp; Histórico" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="Tier3"><mxGeometry x="930" y="55" width="275" height="110" as="geometry" /></mxCell>
        <mxCell id="MCPVector" value="📚 Servidor MCP-VectorDB&#10;Tool: search_normativos_e_laminas&#10;Escopo: mcp:read:rag_corpus&#10;Busca Vetorial c/ Citação Fonte" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="Tier3"><mxGeometry x="1230" y="55" width="265" height="110" as="geometry" /></mxCell>

        <mxCell id="Tier4" value="4. Sistemas Corporativos, Bases de Dados &amp; Trilha de Auditoria Imutável (Zero Acesso Direto pelos LLMs/Agentes)" style="swimlane;startSize=30;fillColor=#e3f2fd;strokeColor=#1565c0;fontColor=#0d47a1;fontStyle=1;rounded=1;html=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="1520" height="190" as="geometry" /></mxCell>
        <mxCell id="SysRiscoCore" value="🏛️ Serviço de Risco &amp; Core Bancário&#10;PostgreSQL CQRS Read Replicas&#10;(Saldos, Posições e Suitability)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="Tier4"><mxGeometry x="40" y="50" width="330" height="115" as="geometry" /></mxCell>
        <mxCell id="SysMarketRedis" value="🔥 Redis Cluster &amp; Market Data&#10;Cotações em Tempo Real (Hot Stream)&#10;e Indicadores Financeiros" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="Tier4"><mxGeometry x="410" y="50" width="320" height="115" as="geometry" /></mxCell>
        <mxCell id="SysCRM" value="🏢 Sistema Legado CRM / ERP&#10;Cadastro Comercial, Mesa de&#10;Operações e Notificações" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="Tier4"><mxGeometry x="770" y="50" width="320" height="115" as="geometry" /></mxCell>
        <mxCell id="SysVectorWORM" value="🔒 Vector DB (Embeddings RAG) +&#10;Kafka auditoria.ia.mcp &amp; WORM&#10;(Conformidade LGPD/BACEN — RNF-06)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="Tier4"><mxGeometry x="1130" y="50" width="360" height="115" as="geometry" /></mxCell>

        <mxCell id="e1" value="1. Gatilho" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="EvtKafka" target="OrqN8N"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="2. Invoca (Anonimizado)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="OrqN8N" target="AgenteAutonomo"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="Prompts / JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;startArrow=block;startFill=1;" edge="1" parent="1" source="AgenteAutonomo" target="MotorLLM"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="Grounding" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;startArrow=block;startFill=1;" edge="1" parent="1" source="MotorLLM" target="MotorRAG"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="6. Retém p/ Aprovação" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="AgenteAutonomo" target="AssessorHitL"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="7. Entrega Tese Assinada" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="AssessorHitL" target="AppInvestidor"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="3. Tools via MCP (JSON-RPC 2.0)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="AgenteAutonomo" target="MCPCore"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="4. Busca Vetorial via MCP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="MotorRAG" target="MCPVector"><mxGeometry relative="1" as="geometry" /></mxCell>
